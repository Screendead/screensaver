#!/usr/bin/python3 -I
"""Battery soak: what the saver costs in watts, battery and heat, run on the laptop until the battery is nearly flat.

  tools/powersoak [app, default build/VoxelReverie.app] [out dir, default build/power]

Start it any time. It waits until the Mac is on battery and nobody has touched it for 5 minutes, then:
  1. baseline: the display held on with nothing else running, 20 minutes;
  2. saver: the app's --preview (VR_TIMING=1) with the display held on, until the battery reaches 3%.
Input dismisses the preview; the run then waits for 5 idle minutes again and carries on. Every 30 s it appends a
sample (battery %, watts, battery temperature, the saver's memory and CPU) to samples.tsv, and at the end writes
summary.txt. Keep the display brightness where it usually is: it moves the watts as much as the saver does.
"""
import os, re, subprocess, sys, time

here = os.path.dirname(os.path.realpath(__file__))
app = os.path.abspath(sys.argv[1] if len(sys.argv) > 1 else os.path.join(here, '../build/VoxelReverie.app'))
out = os.path.abspath(sys.argv[2] if len(sys.argv) > 2 else os.path.join(here, '../build/power'))
binary = os.path.join(app, 'Contents/MacOS/voxelreverie')
BASELINE_S, STOP_PCT, IDLE_S, EVERY = 20 * 60, 3, 300, 30
os.makedirs(out, exist_ok=True)
SAMPLES = os.path.join(out, 'samples.tsv')


def battery():
    t = subprocess.run(['ioreg', '-rn', 'AppleSmartBattery'], capture_output=True, text=True).stdout
    def num(key):
        m = re.search(r'"%s" = (-?\d+)' % key, t)
        return int(m.group(1)) if m else 0
    amps = num('InstantAmperage') or num('Amperage')
    if amps > 2 ** 63:
        amps -= 2 ** 64
    return {'pct': num('CurrentCapacity'), 'watts': -amps * num('Voltage') / 1e6, 'temp_c': num('Temperature') / 100,
            'external': '"ExternalConnected" = Yes' in t}


def idle_s():
    t = subprocess.run(['ioreg', '-c', 'IOHIDSystem'], capture_output=True, text=True).stdout
    m = re.search(r'"HIDIdleTime" = (\d+)', t)
    return int(m.group(1)) / 1e9 if m else 0


def proc(pid):
    if not pid:
        return 0, 0
    t = subprocess.run(['ps', '-o', 'rss=,%cpu=', '-p', str(pid)], capture_output=True, text=True).stdout.split()
    return (int(t[0]) / 1024, float(t[1])) if len(t) == 2 else (0, 0)


def note(s):
    with open(os.path.join(out, 'events.log'), 'a') as f:
        f.write(time.strftime('%Y-%m-%dT%H:%M:%S ') + s + '\n')


def sample(phase, pid=None):
    b, (rss, cpu) = battery(), proc(pid)
    new = not os.path.exists(SAMPLES)
    with open(SAMPLES, 'a') as f:
        if new:
            f.write('time\tphase\tpct\twatts\ttemp_c\tsaver_rss_mb\tsaver_cpu\n')
        f.write('%s\t%s\t%d\t%.2f\t%.1f\t%.0f\t%.0f\n' % (time.strftime('%Y-%m-%dT%H:%M:%S'), phase, b['pct'], b['watts'],
                                                    b['temp_c'], rss, cpu))
    return b


def wait_ready():
    while battery()['external'] or idle_s() < IDLE_S:
        time.sleep(20)


def summary():
    rows = [l.rstrip('\n').split('\t') for l in open(SAMPLES)][1:]
    lines = []
    for phase in ('baseline', 'saver'):
        r = [x for x in rows if x[1] == phase]
        if len(r) < 2:
            continue
        hours = (time.mktime(time.strptime(r[-1][0], '%Y-%m-%dT%H:%M:%S')) - time.mktime(time.strptime(r[0][0], '%Y-%m-%dT%H:%M:%S'))) / 3600
        w = sorted(float(x[3]) for x in r)
        drop = int(r[0][2]) - int(r[-1][2])
        lines.append('%-8s %5.2f h  watts median %.2f (p10 %.2f, p90 %.2f)  battery %s%% -> %s%% (%.1f%%/h)  temp max %.1f C'
                     % (phase, hours, w[len(w) // 2], w[len(w) // 10], w[len(w) * 9 // 10], r[0][2], r[-1][2],
                        drop / hours if hours else 0, max(float(x[4]) for x in r)))
        if phase == 'saver':
            rss = [float(x[5]) for x in r if float(x[5]) > 0]
            if rss:
                lines.append('saver memory (RSS) first %.0f MB, last %.0f MB, max %.0f MB' % (rss[0], rss[-1], max(rss)))
    gpu = []
    for f in sorted(os.listdir(out)):
        if f.startswith('saver') and f.endswith('.log'):
            gpu += [(float(a), float(b)) for a, b in re.findall(r'gpu ms: median ([\d.]+)  p95 ([\d.]+)', open(os.path.join(out, f)).read())]
    if gpu:
        med = sorted(a for a, _ in gpu)
        lines.append('gpu ms per 120 frames: median of medians %.2f, worst p95 %.2f (%d windows)' % (med[len(med) // 2], max(b for _, b in gpu), len(gpu)))
    open(os.path.join(out, 'summary.txt'), 'w').write('\n'.join(lines) + '\n')
    print('\n'.join(lines))


note('waiting for battery power and %d idle seconds' % IDLE_S)
wait_ready()
note('baseline start')
hold = subprocess.Popen(['caffeinate', '-d', '-i'])
t0 = time.time()
while time.time() - t0 < BASELINE_S:
    if idle_s() < EVERY:
        note('input during baseline; restarting it after idle')
        hold.terminate()
        wait_ready()
        hold = subprocess.Popen(['caffeinate', '-d', '-i'])
        t0 = time.time()
    sample('baseline')
    time.sleep(EVERY)
hold.terminate()
run = 0
while True:
    run += 1
    note('saver run %d start' % run)
    log = open(os.path.join(out, 'saver%d.log' % run), 'w')
    saver = subprocess.Popen([binary, '--preview'], stdout=log, stderr=subprocess.STDOUT, env={**os.environ, 'VR_TIMING': '1'})
    hold = subprocess.Popen(['caffeinate', '-d', '-i', '-w', str(saver.pid)])
    b = None
    while saver.poll() is None:
        b = sample('saver', saver.pid)
        if b['pct'] <= STOP_PCT or b['external']:
            break
        time.sleep(EVERY)
    if saver.poll() is None:
        saver.terminate()
    hold.terminate()
    if b and (b['pct'] <= STOP_PCT or b['external']):
        note('stop: battery %d%%%s' % (b['pct'], ', plugged in' if b['external'] else ''))
        break
    note('saver run %d ended (exit %s); waiting for idle' % (run, saver.returncode))
    wait_ready()
summary()
